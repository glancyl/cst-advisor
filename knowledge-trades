  /* Common ways people describe their job, mapped to the trade name used
     in the handbooks. "I'm a scaffolder" needs to find "Scaffolding". */
  var ALIASES = {
    'scaffolder':'Scaffolding', 'scaffolders':'Scaffolding',
    'bricklayer':'Bricklaying', 'brickie':'Bricklaying', 'bricky':'Bricklaying',
    'carpenter':'Carpentry', 'chippy':'Carpentry', 'joiner':'Bench Joinery',
    'plasterer':'Plastering', 'spread':'Plastering',
    'tiler':'Tiling', 'roofer':'Roofing', 'slater':'Roofing (Slater)',
    'glazier':'Glazing', 'painter':'Painting and Decorating',
    'decorator':'Painting and Decorating',
    'groundworker':'Groundworks', 'groundworkers':'Groundworks',
    'dryliner':'Dry Lining Fixing', 'drylining':'Dry Lining Fixing',
    'dry lining':'Dry Lining Fixing', 'dry liner':'Dry Lining Fixing',
    'boarder':'Dry Lining Boarder', 'taper':'Dry Lining Finishing',
    'steelfixer':'Steel Fixing', 'steel fixer':'Steel Fixing',
    'stonemason':'Stonemasonry (External)', 'mason':'Stonemasonry (External)',
    'demolition operative':'Demolition', 'piler':'Piling',
    'formworker':'Formwork', 'shuttering':'Formwork',
    'cladder':'Cladding', 'mastic man':'Mastic', 'sealant':'Mastic',
    'crane operator':'Cranes', 'plant operator':'Plant Maintenance',
    'floor layer':'Floor Coverings', 'flooring':'Floor Coverings',
    'render':'Rendering', 'renderer':'Rendering',
    'traffic marshal':'Traffic Marshall', 'banksman':'Traffic Marshall'
  };

  /* Reduce a trade name to a stem that survives the way people actually
     talk: Scaffolding -> scaffold, Bricklaying -> bricklay, Tiling -> til. */
  function stem(name) {
    var base = name.replace(/\s*\(.*?\)\s*/g, ' ').trim().toLowerCase();
    var first = base.split(/\s+/)[0];
    return first.replace(/(ings|ing|ers|er|s)$/, '');
  }

  window.CSTKnowledge.findTradeEvidence = function (text) {
    if (!text) return null;
    var hay = ' ' + text.toLowerCase().replace(/[^a-z0-9 ]/g, ' ')
                        .replace(/\s+/g, ' ') + ' ';

    // 1. explicit alias — most reliable
    var target = null;
    Object.keys(ALIASES).forEach(function (a) {
      if (hay.indexOf(' ' + a) !== -1) target = ALIASES[a];
    });

    var levels = /level\s*3|lvl\s*3|supervis/.test(hay)
      ? ['level3', 'level2'] : ['level2', 'level3'];

    var best = null;
    levels.forEach(function (lvl) {
      var map = window.CSTKnowledge.tradeEvidence[lvl];
      Object.keys(map).forEach(function (name) {
        var hit = false;
        if (target && name === target) hit = true;
        if (!hit) {
          var base = name.replace(/\s*\(.*?\)\s*/g, ' ').trim().toLowerCase();
          if (base.length >= 5 && hay.indexOf(base) !== -1) hit = true;
        }
        if (!hit) {
          var st = stem(name);
          if (st.length >= 5 && hay.indexOf(st) !== -1) hit = true;
        }
        if (!hit) return;

        /* Score the match. A bracketed variant like "Plastering (Heritage
           Solid)" should only win if the visitor actually said something
           like "heritage" — otherwise the plain "Plastering" is right. */
        var bracket = (name.match(/\((.*?)\)/) || [])[1];
        var score = 0;
        if (target && name === target) score += 30;
        if (bracket) {
          var words = bracket.toLowerCase().split(/[^a-z0-9]+/).filter(function (w) {
            return w.length > 3;
          });
          var asked = words.some(function (w) { return hay.indexOf(w) !== -1; });
          score += asked ? 50 : -20;
        } else {
          score += 10;
        }
        if (!best || score > best.score) {
          best = { level: lvl, name: name, tasks: map[name], score: score };
        }
      });
      if (best) levels.length = 0; // stop at the preferred level
    });
    return best;
  };

  /* Find the sellable product (with its real URL) for a trade name. */
  window.CSTKnowledge.findTradeProduct = function (text, preferLevel) {
    if (!text) return null;
    var hay = ' ' + text.toLowerCase().replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ') + ' ';
    var want = preferLevel || (/level\s*3|lvl\s*3|supervis/.test(hay) ? 3 : 2);
    var best = null;
    TRADE_PRODUCTS.forEach(function (p) {
      var base = p.name.toLowerCase().replace(/[^a-z0-9]/g, ' ').replace(/\s+/g, ' ').trim();
      var words = base.split(' ').filter(function (w) { return w.length >= 4; });
      var quality = 0;
      var hit = (base.length >= 5 && hay.indexOf(base) !== -1);
      if (hit) quality = 100;
      // also match if every significant word appears (handles "dry lining boarder"
      // vs "Dry-Lining Boarder", and "&" vs "and")
      if (!hit && words.length) {
        hit = words.every(function (w) {
          var stem = w.replace(/(ings|ing|ers|er|s)$/, '');
          return hay.indexOf(stem.length >= 4 ? stem : w) !== -1;
        });
        if (hit) quality = 60 + words.length * 5;
      }
      if (!hit) {
        var first = base.split(' ')[0];
        var stemmed = first.replace(/(ings|ing|ers|er|s)$/, '');
        hit = stemmed.length >= 5 && hay.indexOf(stemmed) !== -1;
        if (hit) quality = 20;
      }
      if (!hit) return;
      var score = quality + (p.level === want ? 3 : 0) + (base.length / 100);
      if (!best || score > best.score) best = { p: p, score: score };
    });
    return best ? best.p : null;
  };

  console.log('CSTKnowledge: trade evidence loaded (' +
    Object.keys(window.CSTKnowledge.tradeEvidence.level2).length + ' L2, ' +
    Object.keys(window.CSTKnowledge.tradeEvidence.level3).length + ' L3).');

})();
